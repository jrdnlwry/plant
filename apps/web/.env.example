# Public browser-readable values. These are embedded in the web bundle.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required by server-only account-linking and publication route handlers.
# Never prefix it with NEXT_PUBLIC_ or import it from a Client Component.
SUPABASE_SERVICE_ROLE_KEY=

# Build-only alias accepted by the extension release packager. On Netlify the
# packager uses NEXT_PUBLIC_SITE_URL, so this does not need a second value.
# EXTENSION_SITE_ORIGIN=https://your-site.netlify.app
